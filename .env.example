# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example (placeholders/descriptions, no secrets) is tracked.

# REQUIRED — the app always calls the real CAS e-signing API (there is no
# mock mode). No default is hardcoded in source on purpose — see
# Rule/RULES.md ("không hardcode default cho endpoint/key nội bộ"). A
# missing value fails loudly at startup instead of silently falling back to
# anything.
CAS_ESIGN_BASE_URL=
CAS_ESIGN_CLIENT_ID=
CAS_ESIGN_API_KEY=

# Trusted Root CA certificates are bundled in lib/trustStore/roots/ (public
# data, not a secret — see that folder's README) instead of an env var here.
# To trust an additional root, add a file there; never delete an existing
# one just because a newer generation was added (see the README's
# append-only policy — a document signed under an older root must stay
# verifiable forever).
