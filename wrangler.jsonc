{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xsign-opensource",
  // Must stay >= 2025-08-15 so `enable_nodejs_http_modules` is implied
  // automatically (needed for the `node:http`/`node:https` import inside
  // lib/verification/aiaCertFetcher.ts to load at all on this runtime --
  // see that file's own doc comment for why its actual AIA-fetch behavior
  // still differs here vs. on a real Node.js/VPS deploy).
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Generated by `npm run cf:build` (`opennextjs-cloudflare build`) --
  // never hand-edited, never committed (see .gitignore).
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Works around a real, documented Workers error (1042, "subrequest to own
  // hostname") that can otherwise surface on the first request(s) right
  // after a fresh deploy.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "xsign-opensource"
    }
  ],
  "observability": {
    "enabled": true
  }
}
